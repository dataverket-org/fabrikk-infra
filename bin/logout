#!/usr/bin/env bash
#
# Tier 1 session down. Closes the Proton Pass session, if pass-cli is here,
# and removes the Omni login key from this host; a pass store or a sops file
# has no session of its own. Tier 2 is left to expire within its lifetime, by
# design. This is `task admin:stop`.
#

# shellcheck source=share/admin/admin.sh
source "${0%/*}/../share/admin/admin.sh" || exit $?

key="$(omni_login_key)"
announce_files "$omniconfig" \
	"$key, $operator_key_file and $zitadel_operator_key_file (removed)"
require_tools yq || exit $?

if ! command -v pass-cli >/dev/null; then
	:
elif pass-cli info >/dev/null 2>&1; then
	run pass-cli logout >/dev/null || fail "Proton Pass logout failed!"
	log "Proton Pass session closed"
else
	log "Proton Pass had no session"
fi

if [[ -f "$key" ]]; then
	rm -f "$key" || fail "Could not remove $key!"
	log "Removed the Omni login key; the next omnictl call as you logs in again"
else
	log "No Omni login key on this host"
fi

if [[ -f "$operator_key_file" ]]; then
	rm -f "$operator_key_file" || fail "Could not remove $operator_key_file!"
	log "Removed the Operator key; nothing here can change a cluster now"
else
	log "No Operator key on this host"
fi

if [[ -f "$zitadel_operator_key_file" ]]; then
	rm -f "$zitadel_operator_key_file" ||
		fail "Could not remove $zitadel_operator_key_file!"
	log "Removed the Zitadel operator key; nothing here can write to Zitadel now"
else
	log "No Zitadel operator key on this host"
fi

log "The rest expires by itself; task admin shows when"
