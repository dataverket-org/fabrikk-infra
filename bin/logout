#!/usr/bin/env bash
#
# Tier 3 session down. Closes the Proton Pass session and removes the Omni
# login key from this host. Tier 2 is left alone: it dies by itself within its
# lifetime, and that is the design. If you are inside the session shell that
# task admin:shell opened, exit it afterwards; OS_PASSWORD lives only there.
#

# shellcheck source=share/admin/admin.sh
source "${0%/*}/../share/admin/admin.sh" || exit $?

key="$(omni_login_key)"
announce_files "$omniconfig" "$key (removed)"
require_tools pass-cli yq || exit $?

if pass-cli info >/dev/null 2>&1; then
	run pass-cli logout >/dev/null || fail "Proton Pass logout failed!"
	log "Proton Pass session closed"
else
	log "Proton Pass had no session"
fi

if [[ -f "$key" ]]; then
	rm -f "$key" || fail "Could not remove $key!"
	log "Removed the Omni login key; the next omnictl call as you logs in again"
else
	log "No Omni login key on this host"
fi

log "Tier 2 is untouched and expires by itself; task admin:status shows when"

if [[ -n "$ADMIN_SESSION" ]]; then
	warn "You are inside the session shell from $ADMIN_SESSION; exit it now"
fi
