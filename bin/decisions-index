#!/usr/bin/env bash
#
# Rewrites docs/decisions/README.md from the decision files themselves, then
# prints the set. Each file carries its title, one-line description and
# category in frontmatter, so the index is generated rather than kept in step
# by hand.
#
# In CI, run it and then `git diff --exit-code docs/decisions/README.md`.
#

# shellcheck source=share/logging.sh
source "${0%/*}/../share/logging.sh" || exit $?
# shellcheck source=share/decisions.sh
source "${0%/*}/../share/decisions.sh" || exit $?

#
# Prints "number<TAB>file<TAB>title<TAB>description" for every decision in a
# category, in number order.
#
function rows()
{
	local want="$1"
	local file number

	while read -r file; do
		[[ "$(field "$file" category)" == "$want" ]] || continue
		number="${file##*/}"
		number="${number%%-*}"
		printf '%s\t%s\t%s\t%s\n' "$number" "${file##*/}" \
			"$(field "$file" title)" "$(field "$file" description)"
	done <<<"$(decision_files)"
}

#
# Prints every category a decision file names, one per line.
#
function used_groups()
{
	local file

	while read -r file; do
		field "$file" category
	done <<<"$(decision_files)" | sort -u
}

command -v yq >/dev/null || fail "yq is not on PATH"

{
	cat <<'HEAD'
# Decisions

Why this repository is shaped the way it is. One file each: the problem, the decision, and what follows from it.
The README says what is where, `bootstrap.sh` says how, these say why.

A number is an identity and nothing else. It does not say when a decision was taken, and it does not say what the
decision is about: a new one takes the next free number whatever its subject, so the grouping below comes from
each file's `category:` field and not from the order of the numbers. This page is generated by `bin/decisions`; edit
the decisions, not the index.

A decision is not edited to change its meaning after it is accepted. A change of mind is a new record that says
what it supersedes.
HEAD

	for entry in "${groups[@]}"; do
		slug="${entry%%:*}"
		heading="${entry#*:}"
		body="$(rows "$slug")"
		[[ -n "$body" ]] || continue
		printf '\n## %s\n\n| # | Decision | In one line | Accepted |\n|---|---|---|---|\n' "$heading"
		while IFS=$'\t' read -r number file title description; do
			[[ -n "$number" ]] || continue
			printf '| [%s](%s) | %s | %s | %s |\n' \
				"$number" "$file" "$title" "$description" \
				"$(field "$dir/$file" created)"
		done <<<"$body"
	done

	cat <<'TAIL'

## Renumbered 2026-09-29

The set was reordered once, on 2026-09-29, so that a reader meets the governing decisions first. Seven records
carry that date: 001 and 002 were written earlier the same day, and 004, 007, 008, 009 and 010 were decisions
already taken in the work but never written down. Older references use the numbers on the left.

| Was | Is |
|---|---|
| 001 sops key generated in cluster | 003 |
| 002 zot as plain manifests | 012 |
| 003 zot config self-hosted git fallback | 011 |
| 004 cluster fetches registry through service | 013 |
| 005 cluster repo owns credentials | 006 |
| 006 operations models live here | 005 |
| 007 local PVs through the static provisioner | 014 |
TAIL
} >"$index.tmp" || fail "Could not write $index.tmp!"

mv "$index.tmp" "$index" || fail "Could not replace $index!"

for slug in $(used_groups); do
	printf '%s\n' "${groups[@]}" | grep -q "^$slug:" ||
		warn "category '$slug' is in a decision but not in share/decisions.sh"
done

log "Wrote $index"
echo
table
echo
log "$(summary)"
