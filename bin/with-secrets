#!/usr/bin/env bash
#
# Runs a command with secrets in its environment, each resolved from a
# reference for this one run (share/secrets.sh):
#
#	bin/with-secrets NAME... -- COMMAND [ARGS...]
#
# For every NAME, the reference in NAME_REF fills NAME, unless NAME is already
# set. One that does not resolve is reported and left empty, so the command
# can ask for it itself. The command then replaces this script, and the values
# live in its environment and its children's only, never in an argument or a
# log line. A task opts in by naming its secrets in front of its command:
#
#	cmds: [bin/with-secrets OS_PASSWORD -- bin/openstack]
#

# shellcheck source=share/logging.sh
source "${0%/*}/../share/logging.sh" || exit $?
# shellcheck source=share/secrets.sh
source "${0%/*}/../share/secrets.sh" || exit $?

names=()

while (( $# )); do
	case "$1" in
		--)	shift; break ;;
		-*)	fail "Unknown option: $1" ;;
		*)	names+=("$1"); shift ;;
	esac
done

(( $# )) || fail "Usage: ${0##*/} NAME... -- COMMAND [ARGS...]"

for name in "${names[@]}"; do
	resolve_secret_into "$name" || exit $?
done

exec "$@"
