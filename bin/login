#!/usr/bin/env bash
#
# Tier 1 session up. Opens Omni, whose login key lives a few hours, and Proton
# Pass when OS_PASSWORD_REF is a pass:// reference, and checks the reference.
# The openstack step resolves the password through bin/with-secrets for its
# own run only, so no password stays in any environment. The first step of
# `task admin:start`; `task admin:stop` closes what this opened.
#

# shellcheck source=share/admin/admin.sh
source "${0%/*}/../share/admin/admin.sh" || exit $?

#
# Opens a URL in the default browser, on macOS and Linux alike; not over SSH,
# where the browser is on another screen.
#
function open_url()
{
	local url="$1"

	[[ -z "$SSH_CONNECTION" ]] || return 1

	if   command -v open >/dev/null; then open "$url"
	elif command -v xdg-open >/dev/null; then xdg-open "$url" >/dev/null 2>&1
	else return 1
	fi
}

#
# Checks that Proton Pass has a session; logs in through the browser if not.
# pass-cli prints the login URL and waits; the first one it prints is opened,
# as omnictl does by itself, and every line still reaches the terminal.
#
function proton_pass_login()
{
	local line opened="" status

	if pass-cli info >/dev/null 2>&1; then
		log "Proton Pass session is open"
		return
	fi

	log "Proton Pass: web login, in your browser ..."
	run pass-cli login 2>&1 | while IFS= read -r line; do
		echo "$line"
		if [[ -z "$opened" && "$line" =~ (https://[^[:space:]]+) ]]; then
			open_url "${BASH_REMATCH[1]}" && opened=1
		fi
	done
	status="${PIPESTATUS[0]}"

	(( status == 0 )) || return "$status"
	pass-cli info >/dev/null 2>&1 || return 1
	log "Proton Pass session is open"
}

#
# Checks that the Omni login key is present and not expired; logs in through
# the browser if not, by making any authenticated call.
#
function omni_login()
{
	local expiry

	expiry="$(omni_login_expiry)"

	if [[ -n "$expiry" ]] && (( expiry > now )); then
		log "Omni login key is good until $(omni_login_expires)"
		return
	fi

	log "Omni: browser login ..."
	omni serviceaccount list >/dev/null || return $?
	log "Omni login key is good until $(omni_login_expires)"
}

writes="$(omni_login_key) (Omni writes it on login)"
announce_files "$omniconfig" "$writes, and $omniconfig if missing"
require_tools omnictl gpg yq || exit $?
require_omni_context || exit $?

if [[ "$(secret_backend "$os_password_ref")" == proton ]]; then
	require_tools pass-cli || exit $?
	proton_pass_login || fail "Proton Pass login failed!"
fi

omni_login || fail "Omni login failed!"

if [[ -n "$OS_PASSWORD" ]]; then
	warn "OS_PASSWORD is already set; it wins over any reference"
elif [[ -z "$os_password_ref" ]]; then
	warn "OS_PASSWORD_REF is empty; the OpenStack step asks for the password"
elif secret_ref_usable "$os_password_ref"; then
	log "OpenStack password: $os_password_ref, resolved per run"
else
	warn "Until OS_PASSWORD_REF names yours, the OpenStack step asks for it"
fi
