#!/usr/bin/env bash
#
# The Omni Reader service account for this repository and its key file, which
# talosctl and the read-only omni models name. Created when the account is
# missing, renewed with the rest when due or when the key file no longer
# authenticates, otherwise left alone. Safe to rerun at any time.
#

# shellcheck source=share/admin/admin.sh
source "${0%/*}/../share/admin/admin.sh" || exit $?

announce_files "$omniconfig" "$reader_key_file"
require_tools omnictl || exit $?
require_omni_context || exit $?

ensure_service_account "$id-reader" Reader "$reader_key_file" ||
	fail "The Reader key does not list clusters at $omni_url!"
log "Reader key lists clusters at $omni_url"
