#!/usr/bin/env bash
#
# A DirectAdmin login key for one zone at Nordhost, held by the cluster: tier
# 3, minted from tier 1 with the account password in the operator store
# (decisions 001, 016), which bin/with-secrets puts in NORDHOST_PASSWORD; the
# task names it. Bounded to NORDHOST_COMMANDS and NORDHOST_KEY_DAYS,
# and to NORDHOST_ALLOW_IPS when it is set, and named after the day it
# expires. Once it lists the zone's records, it is written into the zone's
# entry of config.json in the cluster's file with sops set, and is never
# printed: the key is born there, so this is no copy between stores (decision
# 002). The previous key is left alone. Commit the file and push the
# cert-manager artifact; both webhooks read config.json only when they start.
#
# The panel and the account come from the zone's entry in the cluster's
# config.json, the format of nordhost-integrator's cfg package; the password
# is the one value this needs from elsewhere. The default
# command is the one nordhost-integrator's da package calls.
#
# NORDHOST_DRY_RUN=1 mints nothing. It decrypts the cluster's file, lists the
# account's login keys with the password, and lists the zone's records with
# the key the cluster holds now.
#
# NORDHOST_DELETE_KEYS deletes the login keys it names and mints nothing,
# once the new key is pushed and running. The key in the cluster's file must
# list the zone's records before and after, which catches deleting the one
# the cluster uses; it never deletes a key it does not find by name.
#
#	NORDHOST_ZONE		The zone, dvkt.no or dataverket.org
#	NORDHOST_ALLOW_IPS	Addresses the key works from, space separated;
#				empty or unset, any address
#	NORDHOST_PASSWORD	The account password, else asked for once; the
#				task resolves it from NORDHOST_PASSWORD_REF
#	NORDHOST_CLUSTER_FILE	The cluster's file (default
#				artifacts/cert-manager/nordhost-config.enc.yaml)
#	NORDHOST_CONFIG_KEY	sops path to config.json in it
#				(default ["stringData"]["config.json"])
#	NORDHOST_URL		The panel (default the zone's host in config.json)
#	NORDHOST_KEY_DAYS	Lifetime in days, 1 to 365 (default 90)
#	NORDHOST_COMMANDS	Commands allowed, space separated
#				(default CMD_DNS_CONTROL)
#	NORDHOST_KEY_PREFIX	Key name before the expiry date, letters and digits;
#				required to mint
#	NORDHOST_DELETE_KEYS	Login keys to delete, space separated
#	NORDHOST_DRY_RUN	1 tests decryption, the password and the
#				current key, and mints nothing
#	DEBUG			1 prints every external command before it runs
#

# shellcheck source=share/logging.sh
source "${0%/*}/../share/logging.sh" || exit $?

repo_dir="$(cd "${0%/*}/.." && pwd)" || exit $?

enable_debug="${DEBUG:-0}"

zone="$NORDHOST_ZONE"
allow_ips="$NORDHOST_ALLOW_IPS"
password="${NORDHOST_PASSWORD:-}"
cluster_file="${NORDHOST_CLUSTER_FILE:-artifacts/cert-manager/nordhost-config.enc.yaml}"
config_key="${NORDHOST_CONFIG_KEY:-[\"stringData\"][\"config.json\"]}"
base_url="${NORDHOST_URL%/}"
days="${NORDHOST_KEY_DAYS:-90}"
commands="${NORDHOST_COMMANDS:-CMD_DNS_CONTROL}"
prefix="$NORDHOST_KEY_PREFIX"
delete_keys="${NORDHOST_DELETE_KEYS:-}"

case "${NORDHOST_DRY_RUN:-0}" in
	1|true|yes)	dry_run=1 ;;
	*)		dry_run=0 ;;
esac

# fd 3 is the caller's stdout, for the key alone.
exec 3>&1 1>&2

#
# Stops unless every named variable is set.
#
function require_settings()
{
	local name

	for name in "$@"; do
		[[ -n "${!name}" ]] || fail "$name is not set!"
	done
}

#
# Prints a value quoted for a curl config file, with backslashes, double
# quotes and newlines escaped.
#
function curl_quote()
{
	local value="$1"

	value="${value//\\/\\\\}"
	value="${value//\"/\\\"}"
	value="${value//$'\n'/\\n}"
	printf '"%s"' "$value"
}

#
# Prints the curl config lines for a URL and a user:secret.
#
function curl_target()
{
	local url="$1"
	local auth="$2"

	printf 'url = %s\n' "$(curl_quote "$url")"
	printf 'user = %s\n' "$(curl_quote "$auth")"
}

#
# Calls a DirectAdmin command as user:secret and prints the response: a GET
# without fields, a form POST of the name=value pairs with them. URL,
# credential and fields go to curl as a config on stdin.
#
function directadmin()
{
	local command="$1"
	local auth="$2"
	shift 2

	local pair

	{
		curl_target "$base_url/$command" "$auth"
		for pair in "$@"; do
			printf 'data-urlencode = %s\n' "$(curl_quote "$pair")"
		done
	} | run curl --silent --show-error --fail-with-body --config -
}

#
# Calls a DirectAdmin command with json=yes and a JSON body, as
# nordhost-integrator's da package does, and prints the response.
#
function directadmin_json()
{
	local command="$1"
	local auth="$2"
	local body="$3"

	{
		curl_target "$base_url/$command?json=yes" "$auth"
		printf 'header = %s\n' "$(curl_quote "Content-Type: application/json")"
		printf 'data-binary = %s\n' "$(curl_quote "$body")"
	} | run curl --silent --show-error --fail --config -
}

#
# Checks that a DirectAdmin response is an API answer without an error; a
# login page is a refusal.
#
function answered()
{
	local response="$1"

	[[ -n "$response" ]] || return 1
	[[ "$response" != *error=1* ]] || return 1
	[[ "$response" != *"<html"* && "$response" != *"<HTML"* ]] || return 1
}

#
# Prints a URL-encoded string decoded.
#
function url_decode()
{
	local value="${1//+/ }"

	printf '%b' "${value//%/\\x}"
}

#
# Prints one attribute of a login key from its decoded attribute string.
#
function key_attr()
{
	local name="$1"
	local attrs="$2"

	tr '&' '\n' <<<"$attrs" | sed -n "s/^$name=//p" | head -n 1
}

#
# Prints each login key of a DirectAdmin listing on one line: its name, the
# day it expires, and whether this task made it, by NORDHOST_KEY_PREFIX.
# Warns of a key that never expires. DirectAdmin keeps only a hash of a key,
# so which name the cluster holds cannot be told from here.
#
function print_login_keys()
{
	local listing="$1"
	local name attrs expiry made

	while IFS='=' read -r name attrs; do
		[[ -n "$name" && -n "$attrs" && "$name" != error ]] || continue
		name="$(url_decode "$name")"
		attrs="$(url_decode "$attrs")"
		expiry="$(key_attr expiry "$attrs")"
		made=""
		[[ -n "$prefix" && "$name" == "$prefix"[0-9]* ]] &&
			made=", made by this task"

		if [[ -z "$expiry" || "$expiry" == 0 ]]; then
			warn "  $name never expires;" \
			     "NORDHOST_DELETE_KEYS=$name removes it"
		else
			log "  $(printf '%-26s' "$name")" \
			    "expires $(epoch_date "$expiry" +%Y-%m-%d)$made"
		fi
	done < <(tr '&' '\n' <<<"$listing")
}

#
# Prints how many records a login key lists in the zone; fails when DirectAdmin
# refuses it or answers without a record listing.
#
function zone_record_count()
{
	local key="$1"
	local body records

	body="$(jq -cn --arg zone "$zone" '{domain: $zone, json: "yes"}')"
	records="$(directadmin_json CMD_DNS_CONTROL "$user:$key" "$body")" ||
		return 1
	jq -er '.records | length' <<<"$records" 2>/dev/null
}

#
# Deletes one login key by name, with the account password, also in passwd
# as for a create. DirectAdmin's list form, action=select with delete=yes:
# action=delete gets a 500 (2026-10-19). Prints its answer when it refuses.
#
function delete_login_key()
{
	local name="$1"
	local response

	if ! response="$(directadmin CMD_API_LOGIN_KEYS "$user:$password" \
	                 action=select delete=yes "select0=$name" \
	                 "passwd=$password")" ||
	   [[ "$response" != *error=0* ]]; then
		error "DirectAdmin answered: $(answer_text "$response")"
		return 1
	fi
}

#
# Prints the readable part of a DirectAdmin answer, at most 300 characters:
# its error text, or the page without tags. The account password, should the
# answer echo it, is masked.
#
function answer_text()
{
	local response="$1"
	local text

	if [[ "$response" == *text=* ]]; then
		text="$(error_text "$response")"
	else
		text="$(tr -s ' \n\t' ' ' <<<"$response" | sed -e 's/<[^>]*>/ /g')"
	fi

	text="${text//"$password"/***}"
	echo -n "${text:0:300}"
}

#
# Prints DirectAdmin's error text from a response.
#
function error_text()
{
	local response="$1"
	local text="${response#*text=}"

	url_decode "${text%%&*}"
}

#
# Prints a random login key: 64 letters and digits.
#
function random_key()
{
	LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 64
}

#
# Prints an epoch as a UTC date, YYYYMMDD unless a date format is given, on
# BSD and GNU date alike.
#
function epoch_date()
{
	local epoch="$1"
	local format="${2:-+%Y%m%d}"

	date -u -r "$epoch" "$format" 2>/dev/null ||
	date -u -d "@$epoch" "$format" 2>/dev/null
}

#
# Prints one value from a sops file.
#
function sops_value()
{
	local file="$1"
	local path="$2"

	run sops --decrypt --extract "$path" "$file"
}

#
# Prints one field of the zone's entry in config.json, read from stdin.
#
function zone_field()
{
	local field="$1"

	jq -r --arg zone "$zone" --arg field "$field" \
	   '.domains[] | select(.domain == $zone) | .[$field] // empty'
}

require_settings NORDHOST_ZONE
for tool in sops curl jq; do
	command -v "$tool" >/dev/null || fail "$tool is not on PATH!"
done

case "$days" in
	''|*[!0-9]*)	fail "NORDHOST_KEY_DAYS is not a number: $days!" ;;
esac
(( days >= 1 && days <= 365 )) || fail "NORDHOST_KEY_DAYS is not 1 to 365!"

cd "$repo_dir" || exit $?
[[ -f "$cluster_file" ]] || fail "No cluster file at $cluster_file!"

if (( ! dry_run )) && [[ -z "$delete_keys" ]]; then
	require_settings NORDHOST_KEY_PREFIX
	[[ "$prefix" =~ ^[A-Za-z0-9]+$ ]] ||
		fail "NORDHOST_KEY_PREFIX is letters and digits only: $prefix!"
fi

debug "Reads:  NORDHOST_PASSWORD, $cluster_file (config.json)"
if (( dry_run )); then
	debug "Writes: nothing; dry run"
elif [[ -n "$delete_keys" ]]; then
	debug "Writes: deletes login keys $delete_keys at Nordhost"
else
	debug "Writes: a login key at Nordhost, and it into $cluster_file"
fi

config="$(sops_value "$cluster_file" "$config_key")" ||
	fail "Cannot decrypt config.json in $cluster_file!"
user="$(zone_field username <<<"$config")"
current_key="$(zone_field password <<<"$config")"
[[ -n "$user" && -n "$current_key" ]] ||
	fail "config.json in $cluster_file has no entry for $zone!"
[[ -n "$base_url" ]] || base_url="$(zone_field host <<<"$config")"
base_url="${base_url%/}"
debug "Decrypted the entry for $zone in $cluster_file"

[[ "$base_url" == https://* ]] || fail "The panel is not https: $base_url!"

if [[ -z "$password" && -t 0 ]]; then
	read -r -s -p "Nordhost password for $user ($zone): " password </dev/tty
	echo >&2
fi
[[ -n "$password" ]] ||
	fail "No password for $user: run it through task, or set" \
	     "NORDHOST_PASSWORD_REF!"

listing="$(directadmin CMD_API_LOGIN_KEYS "$user:$password")" ||
	fail "The password for $user failed at $base_url!"
answered "$listing" ||
	fail "DirectAdmin refused $user at $base_url: $(error_text "$listing")"
host="${base_url#https://}"
log "$zone: account $user at ${host%%[:/]*}, its login keys:"
print_login_keys "$listing"

if (( dry_run )); then
	count="$(zone_record_count "$current_key")" ||
		fail "The cluster's key lists no records for $zone at $base_url!"
	log "$zone: the cluster's key lists $count records; dry run, nothing minted"
	exit
fi

if [[ -n "$delete_keys" ]]; then
	count="$(zone_record_count "$current_key")" ||
		fail "The cluster's key fails for $zone already; nothing deleted!"
	log "The cluster's key lists $count records in $zone"
	for name in $delete_keys; do
		tr '&' '\n' <<<"$listing" | grep -qx "$name=.*" ||
			fail "No login key $name for $user; nothing more deleted!"
	done
	for name in $delete_keys; do
		delete_login_key "$name" ||
			fail "DirectAdmin did not delete $name!"
		log "Deleted login key $name"
	done
	listing="$(directadmin CMD_API_LOGIN_KEYS "$user:$password")" ||
		fail "Cannot list the login keys of $user!"
	for name in $delete_keys; do
		tr '&' '\n' <<<"$listing" | grep -qx "$name=.*" &&
			fail "Login key $name is still listed after deleting it!"
	done
	count="$(zone_record_count "$current_key")" ||
		fail "The cluster's key for $zone stopped working: it was among $delete_keys!"
	log "The cluster's key still lists $count records in $zone; now:"
	print_login_keys "$listing"
	exit
fi

expires=$(( $(date +%s) + days * 86400 ))
keyname="$prefix$(epoch_date "$expires")" || fail "Cannot format the expiry!"
key="$(random_key)"
(( ${#key} == 64 )) || fail "Cannot generate a key!"

ips=""
for ip in $allow_ips; do
	ips="${ips:+$ips$'\n'}$ip"
done

fields=(action=create type=key "keyname=$keyname" "key=$key" "key2=$key"
        never_expires=no "expiry_timestamp=$expires" max_uses=0
        clear_key=yes allow_html=no "ips=$ips" "passwd=$password"
        create=Create)
i=0
for command in $commands; do
	fields+=("select_allow$i=$command")
	i=$(( i + 1 ))
done

log "Creating key $keyname for $user ($zone): $days days, $commands ..."
log "Allowed from: ${allow_ips:-any address}"
response="$(directadmin CMD_API_LOGIN_KEYS "$user:$password" "${fields[@]}")" ||
	fail "DirectAdmin did not answer at $base_url!"
[[ "$response" == *error=0* ]] ||
	fail "DirectAdmin refused key $keyname: $(error_text "$response")"

listing="$(directadmin CMD_API_LOGIN_KEYS "$user:$password")" ||
	fail "Cannot list the login keys of $user!"
[[ "$listing" == *"$keyname"* ]] ||
	fail "Key $keyname was accepted but is not listed!"

log "Key $keyname is listed for $user; the keys now:"
print_login_keys "$listing"

count="$(zone_record_count "$key")" ||
	fail "The new key lists no records for $zone; nothing written!"
log "The new key lists $count records in $zone"

# The key reaches jq and sops through the environment and stdin, never as an
# argument, so it is in no process listing.
KEY="$key" jq --arg zone "$zone" \
   '(.domains[] | select(.domain == $zone) | .password) = env.KEY' \
   <<<"$config" | jq -Rs . |
	run sops set --value-stdin "$cluster_file" "$config_key" ||
	fail "Cannot write the new key into $cluster_file!"
written="$(sops_value "$cluster_file" "$config_key" | zone_field password)"
[[ "$written" == "$key" ]] ||
	fail "$cluster_file does not hold the new key for $zone after writing!"
log "Wrote the new key for $zone into $cluster_file"
log "Next: commit it, artifacts/cert-manager/push.sh, restart external-dns" \
    "and nordhost-webhook, then delete the previous key with" \
    "NORDHOST_DELETE_KEYS"
