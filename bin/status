#!/usr/bin/env bash
#
# What tier 2 holds right now: where each credential lives, the name it is
# selected by, who owns it and when it expires. Reads only. It announces no
# files, because the table names every one it reads, and it says nothing about
# the tools or the endpoints unless something is wrong with them.
#
# It does authenticate as you, which is the one thing that can write: on a
# first login omnictl saves a PGP key and says so itself.
#

# shellcheck source=share/admin/admin.sh
source "${0%/*}/../share/admin/admin.sh" || exit $?

#
# Prints one row of the tier 2 table: the file it lives in, the name it is
# selected by there, and what that name is worth today. Every name in the
# second column is one a definition or a command uses, which is the whole of
# decision 009.
#
function row()
{
	printf '%-32s %-34s %-10s %-8s %-12s %s\n' \
		"$1" "$2" "$3" "$4" "$5" "$6"
}

#
# Prints a path with $HOME as a tilde, so the column stays readable.
#
function short_path()
{
	local path="$1"

	echo -n "${path/#"$HOME"/\~}"
}

#
# Prints when something with this many seconds left expires, in local time; a
# dash when there is nothing to expire or nothing to expire it.
#
function expires_in()
{
	local left="$1"

	[[ -n "$left" ]] || { echo -n -; return; }

	date -d "@$(( now + left ))" '+%m-%d %H:%M' 2>/dev/null ||
	date -r "$(( now + left ))" '+%m-%d %H:%M' 2>/dev/null ||
	echo -n -
}

#
# Prints the two kube contexts: the kubeconfig, the context in it, and the
# subject of the token behind it.
#
function kube_rows()
{
	local role name user subject left file

	file="$(short_path "$kubeconfig")"

	for role in admin readers; do
		name="$cluster-$role"
		user="$(context_user "$name")"
		# The subject the token actually carries, not the one a renewal would
		# write: after a rename the context is still ours under its old name,
		# and the table says which one until it is next minted.
		subject="$(context_subject "$name")"
		left="$(context_seconds_left "$name")"

		if [[ -z "$user" ]]; then
			row "$file" "$name" absent - - "no such context"
		elif ! context_is_ours "$name" "$role"; then
			row "$file" "$name" hand-made - - "user $user, left alone"
		elif (( left > 0 )); then
			row "$file" "$name" ours "$(humanize "$left")" \
				"$(expires_in "$left")" "$subject"
		else
			row "$file" "$name" ours expired "$(expires_in "$left")" "$subject"
		fi
	done
}

#
# Prints the talos context, which carries no credential and so never expires.
#
function talos_row()
{
	local file

	file="$(short_path "$talosconfig")"

	if ! talos_context_present; then
		row "$file" "$cluster" absent - - "no such context"
	elif talos_context_is_ours; then
		row "$file" "$cluster" ours - - "Omni-proxied, no credential"
	else
		row "$file" "$cluster" hand-made - - "left alone"
	fi
}

#
# Prints one Omni service account key file: the directory, the file a
# definition names in serviceAccountKeyFile, and the role it carries.
#
function key_row()
{
	local file="$1"
	local account="$2"
	local role="$3"
	local absent="$4"
	local left

	if [[ ! -s "$file" ]]; then
		row "$(short_path "${file%/*}")/" "${file##*/}" absent - - "$absent"
		return
	fi

	left="$(service_account_seconds_left "$account")"

	if (( left > 0 )); then
		row "$(short_path "${file%/*}")/" "${file##*/}" ours \
			"$(humanize "$left")" "$(expires_in "$left")" "$role"
	else
		row "$(short_path "${file%/*}")/" "${file##*/}" ours expired \
			"$(expires_in "$left")" "$role"
	fi
}

#
# Prints the cloud entry the openstack models name, and the application
# credential behind it.
#
function cloud_row()
{
	local credential record name left file

	file="$(short_path "$clouds")"
	credential="$(current_credential_id)"
	record="$(credential_record "$credential")"
	name="$(credential_name "$record" "$credential")"
	left="$(credential_seconds_left "$record")"

	if [[ -z "$credential" ]]; then
		row "$file" "$os_cloud" absent - - "no credential in the entry"
	elif [[ -z "$record" ]]; then
		row "$file" "$os_cloud" unknown - - \
			"$credential does not answer; admin:openstack checks it as you"
	elif ! credential_is_ours "$name"; then
		row "$file" "$os_cloud" hand-made - - "$name, left alone"
	elif (( left > 0 )); then
		row "$file" "$os_cloud" ours "$(humanize "$left")" \
			"$(expires_in "$left")" "$name"
	else
		row "$file" "$os_cloud" ours expired "$(expires_in "$left")" "$name"
	fi
}

#
# Prints what you logged in with: tier 1 on this host, which is never a
# credential of its own but what one login left behind.
#
function tier1_rows()
{
	local key identity expiry left

	# The name is the Omni context, as everywhere else in these tables: the
	# file is named after it and you never name the file yourself.
	key="$(omni_login_key)"
	identity="${key##*/}"
	identity="${identity#"$omni_context-"}"
	identity="${identity%.pgp}"

	if [[ -f "$key" ]]; then
		expiry="$(omni_login_expiry)"
		left=$(( ${expiry:-0} - now ))
		if (( left > 0 )); then
			row "$(short_path "${key%/*}")/" "$omni_context" you \
				"$(humanize "$left")" "$(expires_in "$left")" \
				"Omni login as $identity"
		else
			row "$(short_path "${key%/*}")/" "$omni_context" you expired - \
				"Omni login as $identity"
		fi
	else
		row "$(short_path "${key%/*}")/" "$omni_context" absent - - \
			"no Omni login on this host"
	fi

	if ! command -v pass-cli >/dev/null; then
		row "(Proton Pass)" session absent - - "pass-cli is not installed"
	elif pass-cli info >/dev/null 2>&1; then
		row "(Proton Pass)" session you - - "open; admin:logout closes it"
	else
		row "(Proton Pass)" session absent - - "closed"
	fi
}

#
# Prints what processes hold: tier 3, which is permanent by definition, so the
# lifetime columns are empty for every row of it.
#
function tier3_rows()
{
	local vault_keys flux_files glass_files

	vault_keys="$(find "$repo_dir/vaults/infra" -name '*.enc.json' 2>/dev/null |
	              grep -c . || true)"
	flux_files="$(find "$repo_dir/apps" "$repo_dir/artifacts" \
	              "$repo_dir/infrastructure" -name '*.enc.yaml' 2>/dev/null |
	              grep -c . || true)"
	glass_files="$(find "$repo_dir/break-glass" -name '*.enc.yaml' 2>/dev/null |
	               grep -c . || true)"

	row "vaults/infra/" "$vault_keys secrets" swamp - - \
		"swamp-fabrikk-infra decrypts it, unattended"
	row "apps, artifacts, infrastructure/" "$flux_files manifests" cluster - - \
		"cluster-dataverket-prod decrypts them, in-cluster"
	if (( glass_files )); then
		row "break-glass/" "$glass_files files" humans - - \
			"the two YubiKeys and nothing else"
	else
		row "break-glass/" empty humans - - \
			"the two YubiKeys; 2026-09-break-glass.md fills it"
	fi

	if [[ -f "$HOME/.config/sops/age/keys.txt" ]]; then
		row "$(short_path "$HOME/.config/sops/age/keys.txt")" \
			swamp-fabrikk-infra swamp - - "the key that opens the vault"
	else
		row "$(short_path "$HOME/.config/sops/age/keys.txt")" \
			swamp-fabrikk-infra absent - - "nothing here decrypts the vault"
	fi
}

#
# Prints the whole of tier 2 as a table, and what it adds up to.
#
function tier2_status()
{
	local table total due

	table="$(kube_rows; talos_row
		key_row "$reader_key_file" "$me-reader" Reader "a session mints it"
		key_row "$operator_key_file" "$me-operator" Operator \
			"an ordinary session has none"
		cloud_row)"

	echo "TIER 1  what you logged in with"
	row PATH NAME OWNER LEFT EXPIRES DETAIL
	tier1_rows
	echo

	echo "TIER 2  what it minted, and what a definition names"
	row PATH NAME OWNER LEFT EXPIRES DETAIL
	printf '%s\n' "$table"
	echo

	echo "TIER 3  what processes hold, and never expires"
	row PATH NAME OWNER LEFT EXPIRES DETAIL
	tier3_rows
	echo

	# An absent Operator key is the ordinary state, not something to renew; an
	# expired one is, since that means the account went while the file stayed.
	# The row is matched by its path, which is the only place its name appears.
	total="$(printf '%s\n' "$table" | grep -c .)"
	due="$(printf '%s\n' "$table" | grep -cE ' expired ')"
	due=$(( due + $(printf '%s\n' "$table" | grep -v 'operator\.key ' |
	                grep -cE ' absent ') ))

	if (( due )); then
		log "tier 2: $due of $total are expired or absent; task admin:renew"
	else
		log "tier 2: $total items, all current"
	fi
}

require_tools omnictl kubectl talosctl openstack jq yq || exit $?
require_omni_context || exit $?
require_human_cloud || fail "Cannot log in as you through $human_cloud!"

# As you, which is what may open a browser and write a login key.
omni serviceaccount list >/dev/null ||
	fail "Omni did not accept your login in context $omni_context!"

tier2_status
