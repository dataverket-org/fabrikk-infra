#!/usr/bin/env bash
#
# Tools on PATH, your Omni and OpenStack logins in place, and what tier 2
# holds right now: each item, who owns it, and how long it has left. Reads
# only, except that the Omni login itself writes its key on first use.
#

# shellcheck source=share/admin/admin.sh
source "${0%/*}/../share/admin/admin.sh" || exit $?

reads="$omniconfig, $kubeconfig, $talosconfig, $clouds,"
reads="$reads $reader_key_file, $operator_key_file"

#
# Prints one row of the tier 2 table.
#
function row()
{
	printf '%-38s %-11s %-9s %s\n' "$1" "$2" "$3" "$4"
}

#
# Prints the two kube contexts: who owns each and how long it has left.
#
function kube_rows()
{
	local role name user left

	for role in admin readers; do
		name="$cluster-$role"
		user="$(context_user "$name")"
		left="$(context_seconds_left "$name")"

		if [[ -z "$user" ]]; then
			row "kube context $name" absent - "no such context"
		elif ! context_is_ours "$name" "$id-$role"; then
			row "kube context $name" hand-made - "user $user, left alone"
		elif (( left > 0 )); then
			row "kube context $name" ours "$(humanize "$left")" "$id-$role"
		else
			row "kube context $name" ours expired "$id-$role"
		fi
	done
}

#
# Prints the talos context, which carries no credential of its own.
#
function talos_row()
{
	if ! talos_context_present; then
		row "talos context $cluster" absent - "no such context"
	elif talos_context_is_ours; then
		row "talos context $cluster" ours - "Omni-proxied, no credential"
	else
		row "talos context $cluster" hand-made - "left alone"
	fi
}

#
# Prints one Omni service account key file.
#
function key_row()
{
	local label="$1"
	local file="$2"
	local account="$3"
	local absent="$4"
	local left

	if [[ ! -s "$file" ]]; then
		row "$label" absent - "$absent"
		return
	fi

	left="$(service_account_seconds_left "$account")"

	if (( left > 0 )); then
		row "$label" ours "$(humanize "$left")" "$account"
	else
		row "$label" ours expired "$account"
	fi
}

#
# Prints the cloud entry the openstack models name.
#
function cloud_row()
{
	local credential record name left

	credential="$(current_credential_id)"
	record="$(credential_record "$credential")"
	name="$(credential_name "$record" "$credential")"
	left="$(credential_seconds_left "$record")"

	if [[ -z "$credential" ]]; then
		row "cloud $os_cloud" absent - "no credential in the entry"
	elif [[ -z "$record" ]]; then
		row "cloud $os_cloud" unknown - \
			"$credential does not answer for itself; admin:openstack checks it as you"
	elif ! credential_is_ours "$name"; then
		row "cloud $os_cloud" hand-made - "$name, left alone"
	elif (( left > 0 )); then
		row "cloud $os_cloud" ours "$(humanize "$left")" "$name"
	else
		row "cloud $os_cloud" ours expired "$name"
	fi
}

#
# Prints the whole of tier 2 as a table, and what it adds up to.
#
function tier2_status()
{
	local table total due

	table="$(kube_rows; talos_row
		key_row "Omni reader key" "$reader_key_file" "$id-reader" \
			"a session mints it"
		key_row "Omni operator key" "$operator_key_file" "$id-operator" \
			"an ordinary session has none"
		cloud_row)"

	row ITEM OWNER LEFT DETAIL
	printf '%s\n' "$table"
	echo

	# An absent Operator key is the ordinary state, not something to renew; an
	# expired one is, since that means the account went while the file stayed.
	total="$(printf '%s\n' "$table" | grep -c .)"
	due="$(printf '%s\n' "$table" | grep -cE ' expired ')"
	due=$(( due + $(printf '%s\n' "$table" | grep -v '^Omni operator key' |
	                grep -cE ' absent ') ))

	if (( due )); then
		log "$due of $total are expired or absent; task admin:renew"
	else
		log "$total items, all current"
	fi
}

announce_files "$reads" "$(omni_login_key) (Omni, on first login)"

require_tools omnictl kubectl talosctl openstack jq yq || exit $?
require_omni_context || exit $?
log "Tools present: omnictl kubectl talosctl openstack jq yq"

log "Omni login as you (a browser opens on first use) ..."
omni serviceaccount list >/dev/null ||
	fail "Omni at $omni_url did not accept your login!"
log "$omni_url answers through $omniconfig"
expires="$(omni_login_expires)"
[[ -z "$expires" ]] || log "Your Omni login key expires at $expires (tier 3)"

require_human_cloud || fail "Cannot log in as you through $human_cloud!"

echo
tier2_status
