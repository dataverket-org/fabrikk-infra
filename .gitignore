.env.sh
cloud.conf
create-forgejo-secret.sh
create-forgejo-mailer-secret.sh
create-forgejo-zitadel-oauth-secret.sh
create-zitadel-master-key.sh
*.example.yaml

# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section

# SOPS vault: plaintext scratch file written during vault put (vaults/*.enc.json is safe to commit)
vaults/*.plain.tmp
_bin/

# Backup sites (backup/<site>): only the CA root is committed. A site's .env, keys and certificate belong to the site's own repository (hov1).
backup/*/.env
backup/*/certs/*
!backup/*/certs/ca.crt

# Charts kustomize pulls while rendering an artifact recipe (artifacts/*/render.sh)
artifacts/*/recipe/charts/
# The runner chart has no chart repository to pull from, so it is kept here (artifacts/forgejo-runners/README.md).
!artifacts/forgejo-runners/recipe/charts/
