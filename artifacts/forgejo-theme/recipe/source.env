# What render.sh builds the theme from. The Forgejo version is not here: render.sh reads it from the chart that
# runs (apps/forgejo/repo.yaml, the chart's appVersion), so a chart upgrade cannot leave the locale behind.
THEME_REPO=https://git.dataverket.org/dataverket/forgejo-theme.git
THEME_COMMIT=c9a2bf0883d4b99b596c41bc408c14ee543e0237
