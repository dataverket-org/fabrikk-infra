#!/bin/sh
# Mint one account and its bucket on the running gateway and print, on stdout, the Kubernetes Secret the writer
# reads: pipe it through sops, never onto disk in clear. Run from the site directory.
#   usage: bin/user <bucket> <namespace> [--rotate]
# The account is named after the bucket, gets the role "user", which sees only buckets it owns, and the bucket is
# created owned by it (or handed over when it already exists). --rotate deletes an existing account first and
# mints a new key pair: the writer fails from that moment until the new Secret is applied, which WAL archiving
# and restic tolerate, so commit at once. Without --rotate an existing account is an error.
set -eu
[ -f .env ] || { echo "run from a site directory: no .env here" >&2; exit 2; }
set -a; . ./.env; set +a
bucket=${1:?bucket}; namespace=${2:?namespace}; rotate=${3:-}
secret=$(head -c 30 /dev/urandom | base64 | tr -d '/+=' | head -c 40)
# The root key pair stays inside the container: the admin CLI reads it from the environment versitygw itself was
# started with, and the new account's secret arrives on stdin. Nothing secret is ever an argument on the host,
# where a failing command is echoed with its arguments.
admin() {
  docker compose exec -T versitygw sh -c \
    'exec versitygw admin -a "$ROOT_ACCESS_KEY" -s "$ROOT_SECRET_KEY" -r "$0" -er http://localhost:7071 "$@"' \
    "$REGION" "$@"
}
if [ "$rotate" = "--rotate" ]; then admin delete-user -a "$bucket" >&2; fi
printf '%s\n' "$secret" | docker compose exec -T versitygw sh -c \
  'read -r s; exec versitygw admin -a "$ROOT_ACCESS_KEY" -s "$ROOT_SECRET_KEY" -r "$0" -er http://localhost:7071 create-user -a "$1" -s "$s" -r user' \
  "$REGION" "$bucket" >&2
if admin list-buckets 2>/dev/null | awk 'NR>2 {print $1}' | grep -qx "$bucket"; then
  admin change-bucket-owner -b "$bucket" -o "$bucket" >&2
else
  admin create-bucket --bucket "$bucket" -o "$bucket" >&2
fi
cat <<YAML
apiVersion: v1
kind: Secret
metadata:
  name: s3-$bucket
  namespace: $namespace
type: Opaque
stringData:
  BUCKET: $bucket
  ACCESS_KEY_ID: $bucket
  SECRET_ACCESS_KEY: $secret
YAML
echo "account $bucket minted on $SITE; the secret key is in the manifest above, and in clear only in the gateway's IAM store" >&2
