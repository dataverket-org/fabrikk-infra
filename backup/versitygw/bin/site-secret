#!/bin/sh
# Print the site's public facts as a plain Kubernetes Secret for one namespace: the CA root, the endpoint and the
# region. Nothing in it is secret, so the manifest is committed as it is, and an address change is a plaintext diff
# and not a sops edit per writer. Run from the site directory after bin/cert.   usage: bin/site-secret <namespace>
set -eu
[ -f .env ] || { echo "run from a site directory: no .env here" >&2; exit 2; }
set -a; . ./.env; set +a
namespace=${1:?namespace}
cat <<YAML
apiVersion: v1
kind: Secret
metadata:
  name: $SITE-s3
  namespace: $namespace
type: Opaque
stringData:
  ENDPOINT: https://$S3_ADDR
  REGION: $REGION
data:
  ca.crt: $(base64 -w0 < certs/ca.crt)
YAML
