#!/bin/sh
# The site's private CA and the gateway's certificate, made offline with step in a throwaway container; nothing
# stays running. Run from the site directory. First run: certs/ca.crt and certs/ca.key, a root valid three years.
# Every run: certs/tls.crt and certs/tls.key for the address in .env, valid three years, and a reload of the gateway
# if it runs (versitygw reloads its certificate on SIGHUP). Reissue before expiry is this script again; a new root is
# `rm certs/ca.*` first, then bin/site-secret and a commit per namespace. Keep ca.key with .env in the password
# manager: with both, a rebuilt host serves the same root and no client changes.
set -eu
[ -f .env ] || { echo "run from a site directory: no .env here" >&2; exit 2; }
set -a; . ./.env; set +a
host=${S3_ADDR%:*}
years=${CERT_YEARS:-3}
hours=$((years * 8766))h
image=smallstep/step-cli:0.30.6
mkdir -p certs
# --user 0: under rootless Podman container root is the host user, so the files come out owned by whoever runs this.
step() { docker run --rm --user 0 -v "$(pwd)/certs:/certs" -w /certs "$image" step "$@"; }
if [ ! -f certs/ca.key ]; then
  step certificate create "$SITE S3 CA" ca.crt ca.key --profile root-ca --not-after "$hours" --no-password --insecure
fi
step certificate create "$host" tls.crt tls.key --profile leaf --san "$host" --ca ca.crt --ca-key ca.key \
  --not-after "$hours" --no-password --insecure --force
chmod 0600 certs/ca.key certs/tls.key
docker compose up -d
docker compose kill -s HUP versitygw
step certificate inspect tls.crt --short
step certificate inspect ca.crt --short
