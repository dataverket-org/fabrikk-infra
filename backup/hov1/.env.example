# Copy to .env and fill in. .env is ignored by git. Both compose and sh read it: values of letters, digits and
# punctuation other than # $ ' " and spaces, unquoted.

# Names the containers, the CA, and the CA Secret in the cluster; the directory's name.
SITE=hov1

# The account that mints IAM users. Long, random, used by bin/user and by nothing that runs unattended.
ROOT_ACCESS_KEY=
ROOT_SECRET_KEY=

# Gateway root (buckets are its top-level directories) and the directory for previous object versions.
# The versions directory must lie outside the root. Both need a filesystem with xattrs (ext4, xfs).
DATA_DIR=/srv/hov1/s3
VERSIONS_DIR=/srv/hov1/s3-versions

# The address clients use; bin/cert puts it in the certificate (an IP or a name). Port 443 is forwarded to this host.
S3_ADDR=213.128.185.82:443

# What every client signs with; the gateway rejects any other. The S3 default, unless there is a reason.
REGION=us-east-1


# Optional. PORT is the published port, LISTEN narrows the published address, CERT_YEARS the lifetime of the CA and
# the certificate bin/cert makes.
#PORT=443
#LISTEN=0.0.0.0
#CERT_YEARS=3
