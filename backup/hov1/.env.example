# Copy to .env and fill in. .env is ignored by git.

# The account that mints IAM users. Long, random, used by bin/user and by nothing that runs unattended.
ROOT_ACCESS_KEY=
ROOT_SECRET_KEY=

# Gateway root (buckets are its top-level directories) and the directory for previous object versions.
# The versions directory must lie outside the root. Both need a filesystem with xattrs (ext4, xfs).
DATA_DIR=/srv/hov1/s3
VERSIONS_DIR=/srv/hov1/s3-versions

# The public address clients use; bin/cert puts the IP in the certificate. Port 443 is forwarded to the gateway.
S3_ADDR=213.128.185.82:443

# step-ca's password: encrypts the CA keys and is the admin provisioner's password. Long, random, set once.
STEP_CA_PASSWORD=

# Optional. REGION is what clients put in their signature; LISTEN narrows the published address.
#REGION=hov1
#LISTEN=0.0.0.0
