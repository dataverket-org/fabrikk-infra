#!/bin/sh
# Issue the gateway's certificate from the site's step-ca. First run: brings the CA up (it initialises itself),
# widens the admin provisioner's certificate lifetime from the 24 h default to 30 days (max 90), exports the root
# to certs/ca.crt, which is committed and pinned by every client. Every run: issues tls.crt/tls.key for the address
# in .env and (re)starts the stack. Renewal after that is step-renew's job, not this script's.
set -eu
cd "$(dirname "$0")/.."
set -a; . ./.env; set +a
ip=${S3_ADDR%:*}
mkdir -p certs
docker compose up -d --wait step-ca
ca() { docker compose exec -T step-ca "$@"; }
ca sh -c 'umask 077; printf %s "$DOCKER_STEPCA_INIT_PASSWORD" > /tmp/pw'
ca step ca provisioner update admin --x509-default-dur 720h --x509-max-dur 2160h \
  --admin-subject step --admin-provisioner admin --admin-password-file /tmp/pw
ca sh -c 'cat "$(step path)/certs/root_ca.crt"' > certs/ca.crt
ca step ca certificate "$ip" /certs/tls.crt /certs/tls.key --san "$ip" \
  --provisioner admin --provisioner-password-file /tmp/pw --not-after 720h --force
ca rm -f /tmp/pw
docker compose up -d
docker compose exec -T step-ca step certificate inspect /certs/tls.crt --short
